# 演示模式：启用固定演示密码 demo12345678 和内置示例数据，仅用于效果演示。
# 示例数据按浏览器各存一份副本，访客之间互不影响；改为 0 后示例数据只是从界面隐藏，真实提交不受影响。
# 实际部署前必须改为 0，并设置下方真实的 ADMIN_PASSWORD。
DEMO_MODE=1

# 演示副本数量上限：每个新浏览器身份会复制一份示例数据，达到上限后只签发身份、不再复制。
DEMO_MAX_CLONES=3000

# 管理员密码（正式环境必须设置至少 12 位强密码）
ADMIN_PASSWORD=replace_with_a_strong_server_only_password

# 管理员会话签名密钥（至少 32 个随机字符，正式环境必须设置）
SESSION_SECRET=replace_with_at_least_32_random_characters

# 正式服务的内容密钥：openssl rand -base64 32；必须独立部署/备份，不得与数据库打包
# DEMO_MODE=0 时必填，缺失/错误密钥失败关闭。遗失后无法恢复密文。
CONTENT_ENCRYPTION_KEY=

# API_TOKEN：兼容占位，已弃用；服务端不读取，不提供API鉴权，不必设置
# 实际权限由管理员/用户HttpOnly Cookie和路由授权校验控制；勿以此字段代替它们
API_TOKEN=your_api_token_here

# 数据库路径
DATABASE_PATH=./data/anonyproof.db

# 服务器端口
PORT=4000

# 前端端口
NEXT_PUBLIC_PORT=3000

# 环境
NODE_ENV=production

# 必须显式配置准确 Origin（不含路径/尾斜杠/通配符）；生产只列本站
# 本地开发按实际地址另设，例如 http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=https://anonyproof.deline.top

# 经 Nginx 等反向代理部署时设为 1，用于获取真实访问 IP
TRUST_PROXY=1

# 后台登录页面地址（后端首页会引导管理员进入此页面）
ADMIN_UI_URL=http://127.0.0.1:3000/anonyproof/foorpynona

# 前端 API 代理目标
API_PROXY_TARGET=http://127.0.0.1:4000

# 日志级别
LOG_LEVEL=info

# 速率限制（每15分钟最大请求数）
RATE_LIMIT_MAX=100

# 通知轮询间隔（毫秒）
NOTIFICATION_POLL_INTERVAL=30000
