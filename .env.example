# 演示模式：公开固定密码，仅授权合成模板和当前浏览器沙箱，不接真实敏感材料。
# 提交/评论/处理说明只能选择固定示例；公共模板只读，原始日志不可读。
# 正式实例另用独立数据库/凭证/内容密钥；不要通过切换开关混用演示库与正式库。
# 必须显式设置角色与开关，矛盾/缺失会在业务和访问日志建表前失败关闭。
INSTANCE_ROLE=demo
DEMO_MODE=1

# 演示副本数量上限：每个新浏览器身份会复制一份示例数据，达到上限后只签发身份、不再复制。
DEMO_MAX_CLONES=3000

# 管理员密码（正式环境必须设置至少 12 位强密码）
ADMIN_PASSWORD=replace_with_a_strong_server_only_password

# 管理员会话签名密钥（至少 32 个随机字符，正式环境必须设置）
SESSION_SECRET=replace_with_at_least_32_random_characters

# 正式服务的内容密钥：openssl rand -base64 32；必须独立部署/备份，不得与数据库打包
# DEMO_MODE=0 时必填，缺失/错误密钥失败关闭。遗失后无法恢复密文。
CONTENT_ENCRYPTION_KEY=

# API_TOKEN：兼容占位，已弃用；服务端不读取，不提供API鉴权，不必设置
# 实际权限由管理员/用户HttpOnly Cookie和路由授权校验控制；勿以此字段代替它们
API_TOKEN=your_api_token_here

# 必须填写绝对路径；demo/formal 分别使用独立库和独立 checkout。
# 例如 /srv/anonyproof-demo/data/demo.db；未标角色的非空旧库需受控迁移。
DATABASE_PATH=

# 服务器端口
PORT=4000

# 前端端口
NEXT_PUBLIC_PORT=3000

# 环境
NODE_ENV=production

# 必须显式配置准确 Origin（不含路径/尾斜杠/通配符）；生产只列本站
# 本地开发按实际地址另设，例如 http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=https://anonyproof.deline.top

# 代理模式强制校验独立私有键；开发无代理显式使用0和socket来源
TRUST_PROXY=1
# 生成32随机字节的base64，独立部署；不得复用内容/会话密钥
# 与本站私有Nginx include中的X-AnonyProof-Proxy-Auth保持一致，不提交真实值
PROXY_AUTH_KEY=

# 后台登录页面地址（后端首页会引导管理员进入此页面）
ADMIN_UI_URL=http://127.0.0.1:3000/anonyproof/foorpynona

# 前端 API 代理目标
API_PROXY_TARGET=http://127.0.0.1:4000

# 日志级别
LOG_LEVEL=info

# 旧 RATE_LIMIT_MAX 已弃用且不生效，保留兼容占位；设置它不提供限流保护
RATE_LIMIT_MAX=100

# 实际生效的单进程请求窗口（毫秒）；来源按后端识别IP，代理链须另验收
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_RATE_LIMIT_MAX=10
IDENTITY_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_MAX_RECORDS=100000
RECOVERY_RATE_LIMIT_MAX=10
RECOVERY_RATE_LIMIT_WINDOW_MS=60000
FEEDBACK_RATE_LIMIT_MAX=10
FEEDBACK_IDENTITY_RATE_LIMIT_MAX=10
FEEDBACK_RATE_LIMIT_WINDOW_MS=60000
COMMENT_RATE_LIMIT_MAX=60
COMMENT_IDENTITY_RATE_LIMIT_MAX=20
COMMENT_RATE_LIMIT_WINDOW_MS=60000

# 通知轮询间隔（毫秒）
NOTIFICATION_POLL_INTERVAL=30000
